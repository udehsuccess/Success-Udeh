rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Primitives
    // ---------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSymbol(sym) {
      return sym is string && sym.size() >= 1 && sym.size() <= 12 && sym.matches('^[A-Z0-9.\\-]+$');
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // ---------------------------------------------------------
    // Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    // ---------------------------------------------------------
    function isValidUser(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'selectedSymbol', 'theme', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'selectedSymbol', 'activeWatchlistId', 'theme', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        isValidSymbol(data.selectedSymbol) &&
        (!('activeWatchlistId' in data) || (
          data.activeWatchlistId is string &&
          data.activeWatchlistId.size() <= 128 &&
          data.activeWatchlistId.matches('^[a-zA-Z0-9_\\-]*$')
        )) &&
        data.theme is string &&
        data.theme in ['light', 'dark'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWatchlist(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'name', 'symbols', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'name', 'symbols', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 60 &&
        data.symbols is list &&
        data.symbols.size() <= 50 &&
        (data.symbols.size() == 0 || isValidSymbol(data.symbols[0])) &&
        data.sortOrder is number &&
        data.sortOrder >= 0 &&
        data.sortOrder <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHolding(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'symbol', 'companyName', 'shares', 'avgCost', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'symbol', 'companyName', 'shares', 'avgCost', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidSymbol(data.symbol) &&
        data.companyName is string &&
        data.companyName.size() >= 1 &&
        data.companyName.size() <= 120 &&
        data.shares is number &&
        data.shares > 0 &&
        data.shares <= 1000000000 &&
        data.avgCost is number &&
        data.avgCost >= 0 &&
        data.avgCost <= 10000000 &&
        data.notes is string &&
        data.notes.size() <= 300 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAlert(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'symbol', 'condition', 'targetPrice', 'status', 'note', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'symbol', 'condition', 'targetPrice', 'status', 'note', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidSymbol(data.symbol) &&
        data.condition is string &&
        data.condition in ['above', 'below'] &&
        data.targetPrice is number &&
        data.targetPrice > 0 &&
        data.targetPrice <= 10000000 &&
        data.status is string &&
        data.status in ['active', 'triggered', 'dismissed'] &&
        data.note is string &&
        data.note.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSession(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'deviceLabel', 'deviceType', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'deviceLabel', 'deviceType', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.deviceLabel is string &&
        data.deviceLabel.size() >= 1 &&
        data.deviceLabel.size() <= 80 &&
        data.deviceType is string &&
        data.deviceType in ['desktop', 'tablet', 'mobile'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection: /users/{userId} (PII Isolated to Owner Only)
    // ---------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: Update workspace preferences (symbol, watchlist, theme)
          incoming().diff(existing()).affectedKeys().hasOnly(['selectedSymbol', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['activeWatchlistId', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['selectedSymbol', 'activeWatchlistId', 'updatedAt']) ||
          // Action: Sync profile identity metadata from Google login
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
        );

      allow delete: if false;

      // -------------------------------------------------------
      // Subcollection: /users/{userId}/watchlists/{watchlistId}
      // -------------------------------------------------------
      match /watchlists/{watchlistId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(watchlistId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(watchlistId) &&
          isValidWatchlist(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(watchlistId) &&
          isValidWatchlist(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            // Action: Rename watchlist
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) ||
            // Action: Update tracked symbols
            incoming().diff(existing()).affectedKeys().hasOnly(['symbols', 'updatedAt']) ||
            // Action: Reorder watchlist
            incoming().diff(existing()).affectedKeys().hasOnly(['sortOrder', 'updatedAt']) ||
            // Action: Rename and update symbols together
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'symbols', 'updatedAt'])
          ) &&
          userExists(userId);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(watchlistId) &&
          userExists(userId);
      }

      // -------------------------------------------------------
      // Subcollection: /users/{userId}/holdings/{holdingId}
      // -------------------------------------------------------
      match /holdings/{holdingId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(holdingId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(holdingId) &&
          isValidHolding(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(holdingId) &&
          isValidHolding(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().symbol == existing().symbol &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            // Action: Edit position shares, avgCost, or notes
            incoming().diff(existing()).affectedKeys().hasOnly(['shares', 'avgCost', 'notes', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['shares', 'avgCost', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['shares', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt'])
          ) &&
          userExists(userId);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(holdingId) &&
          userExists(userId);
      }

      // -------------------------------------------------------
      // Subcollection: /users/{userId}/alerts/{alertId}
      // -------------------------------------------------------
      match /alerts/{alertId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(alertId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(alertId) &&
          isValidAlert(incoming(), userId) &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(alertId) &&
          isValidAlert(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().symbol == existing().symbol &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          // Terminal state lock: once dismissed, alert cannot be reopened or modified
          existing().status != 'dismissed' &&
          (
            // Action: Trigger or dismiss or re-arm an alert
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
              (
                (existing().status == 'active' && incoming().status in ['triggered', 'dismissed']) ||
                (existing().status == 'triggered' && incoming().status in ['active', 'dismissed'])
              )
            ) ||
            // Action: Edit active alert target/condition/note
            (
              existing().status == 'active' &&
              incoming().status == 'active' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['condition', 'targetPrice', 'note', 'updatedAt'])
            )
          ) &&
          userExists(userId);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(alertId) &&
          userExists(userId);
      }

      // -------------------------------------------------------
      // Subcollection: /users/{userId}/sessions/{sessionId}
      // -------------------------------------------------------
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          isValidSession(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          isValidSession(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            // Action: Heartbeat / refresh device metadata
            incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['deviceLabel', 'deviceType', 'updatedAt'])
          ) &&
          userExists(userId);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          userExists(userId);
      }
    }
  }
}
